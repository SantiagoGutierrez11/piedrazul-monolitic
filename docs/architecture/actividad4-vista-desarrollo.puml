@startuml ComponentesPiedrazul
title Vista de Desarrollo — Diagrama de Componentes (Modelo 4+1)
skinparam componentStyle rectangle

actor "Cliente Angular (SPA)" as Cliente

package "Backend - Monolito modular (FastAPI)" {
  [Appointment] as Appointment
  [Medical Staff] as MedicalStaff
  [Configuration] as Configuration
  [Patient] as Patient
  [Identity] as Identity
  [core (Event Bus, Security, DB Session)] as Core
  [shared (festivos, reloj)] as Shared
}

cloud "Keycloak\n(proveedor de identidad)" as Keycloak

database "Base de datos\n(PostgreSQL, 1 schema por módulo)" as BD

Cliente --> Appointment : HTTP / REST
Cliente --> Patient : HTTP / REST
Cliente --> Identity : HTTP / REST
Cliente --> Configuration : HTTP / REST
Cliente --> MedicalStaff : HTTP / REST

Appointment ..> MedicalStaff : usa interfaz (valida profesional)
Appointment ..> Patient : usa interfaz (resuelve paciente)
Appointment ..> Configuration : usa interfaz (ventana y horario)
MedicalStaff ..> Configuration : usa interfaz (horario configurado)
MedicalStaff ..> Appointment : usa interfaz (horas ocupadas)
Patient ..> Identity : usa interfaz (crea cuenta)
Appointment ..> Shared : festivos y hora actual
MedicalStaff ..> Shared : festivos y hora actual

Appointment ..> Core : publica eventos de citas (agendada, cancelada, atendida)
Configuration ..> Core : publica cambios de horario
Identity --> Keycloak : OpenID Connect
Core --> Keycloak : llaves públicas (JWKS)

Appointment --> BD
MedicalStaff --> BD
Configuration --> BD
Patient --> BD

note bottom of Core
  Comunicación entre módulos vía
  interfaces Python (imports directos)
  y el Event Bus in-process,
  no HTTP interno.
end note

@enduml

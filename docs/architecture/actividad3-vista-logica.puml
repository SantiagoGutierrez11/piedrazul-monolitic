@startuml VistaLogicaPiedrazul
title Vista Lógica — Diagrama de Clases del Dominio (Modelo 4+1)

skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor White
    BorderColor #2C3E50
    ArrowColor #2980B9
}
skinparam package {
    BackgroundColor #F4F8FB
    BorderColor #1168BD
    FontColor #1168BD
    FontStyle bold
}

package "Módulo Patient" {
  class Patient {
    - patient_id : int
    - first_name : str
    - middle_name : str
    - last_name : str
    - second_last_name : str
    - phone : str
    - email : str
    - birth_date : date
    - gender : Gender
    - document_type : DocumentType
    - document_number : str
    - user_id : str
    --
    + full_name : str
  }

  enum Gender {
    FEMENINO
    MASCULINO
    OTRO
  }

  enum DocumentType {
    CC
    TI
    CE
    PA
  }
}

package "Módulo Medical Staff" {
  class Doctor {
    - doctor_id : int
    - full_name : str
    - specialty : str
    - active : bool
  }
}

package "Módulo Configuration" {
  class DoctorScheduleConfiguration {
    - id : int
    - doctor_id : int
    - day_of_week : int
    - start_time : time
    - end_time : time
    - interval_minutes : int
  }

  class SystemParameter {
    - key : str
    - value : str
    - description : str
  }
}

package "Módulo Appointment" {
  class Appointment {
    - appointment_id : int
    - patient_id : int
    - doctor_id : int
    - doctor_name : str
    - service_type : ServiceType
    - date : date
    - start_time : time
    - end_time : time
    - reason : str
    - notes : str
    - status : AppointmentStatus
    --
    + schedule() : None
    + reschedule() : None
    + cancel() : None
    + mark_as_attended(today) : None
  }

  enum ServiceType {
    CONSULTA_GENERAL
    FISIOTERAPIA
    QUIROPRAXIA
    TERAPIA_NEURAL
  }

  enum AppointmentStatus {
    AGENDADA
    REAGENDADA
    ATENDIDA
    CANCELADA
  }

  class PatientAuthorization {
    - authorization_id : int
    - patient_id : int
    - service_type : ServiceType
    - authorized_at : datetime
    - expires_at : datetime
    - authorized_by_doctor_id : int
    - appointment_id : int
    - used : bool
    --
    + is_active(now) : bool
  }
}

Patient "1" -- "0..*" Appointment : solicita >
Doctor "1" -- "0..*" Appointment : atiende >
Doctor "1" -- "0..7" DoctorScheduleConfiguration : tiene configurado >
Appointment "1" --> "1" ServiceType
Appointment "1" --> "1" AppointmentStatus
Patient "1" -- "0..*" PatientAuthorization : recibe >
Appointment "1" -- "0..1" PatientAuthorization : otorga >
PatientAuthorization "1" --> "1" ServiceType
Patient --> Gender
Patient --> DocumentType

note bottom of Appointment
  La relación con Patient y Doctor se
  materializa por identificador (patient_id,
  doctor_id), no por referencia directa:
  cada módulo es dueño de sus propias tablas
  y los datos del paciente se resuelven a
  través de la interfaz pública del módulo
  Patient (PatientDirectory).
end note

note right of PatientAuthorization
  La otorga el médico al atender una
  Consulta General; habilita un servicio
  especializado, se usa una sola vez y
  caduca al mes.
end note

note left of Patient
  user_id enlaza al paciente con su
  cuenta de acceso en Keycloak.
end note

note right of SystemParameter
  Parámetro global del sistema; hoy
  almacena la ventana de agendamiento
  en semanas.
end note

@enduml

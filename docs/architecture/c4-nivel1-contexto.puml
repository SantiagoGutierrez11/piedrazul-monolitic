@startuml
!include <C4/C4_Context>

LAYOUT_WITH_LEGEND()

title Diagrama de Contexto - Sistema de Agendamiento de Citas Médicas Piedrazul (Monolito Modular)

Person(paciente, "Paciente", "Crea su cuenta, agenda su cita de forma autónoma, consulta y cancela sus citas")
Person(agendador, "Agendador", "Consulta la agenda de los profesionales; el registro manual de citas queda para la siguiente iteración")
Person(medico, "Médico / Terapista", "Consulta su agenda, marca las citas atendidas y autoriza servicios especializados")
Person(admin, "Administrador", "Configura la ventana de agendamiento y el horario de atención de cada profesional")

System(piedrazul, "Sistema de Agendamiento\nPiedrazul", "Monolito modular (Angular + FastAPI) con su base de datos PostgreSQL y su proveedor de identidad Keycloak; los módulos internos se comunican por interfaces de Python y un event bus en memoria")

System_Ext(correo, "Servicio de Correo", "Proveedor SMTP/API externo previsto para enviar recordatorios de citas (pendiente de integrar)")

Rel(paciente, piedrazul, "Se registra, agenda, consulta y cancela citas", "HTTPS")
Rel(agendador, piedrazul, "Consulta la agenda de un profesional por fecha", "HTTPS")
Rel(medico, piedrazul, "Consulta su agenda y registra la atención", "HTTPS")
Rel(admin, piedrazul, "Configura parámetros y horarios", "HTTPS")

Rel(piedrazul, correo, "Enviará recordatorios de citas", "SMTP/API")

@enduml

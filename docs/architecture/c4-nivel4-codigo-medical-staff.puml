@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam class {
    BackgroundColor White
    BorderColor #2C3E50
    ArrowColor  #2980B9
    FontName    Arial
}
skinparam package {
    BackgroundColor #F4F8FB
    BorderColor #1168BD
    FontColor #1168BD
    FontStyle bold
}
title Diagrama de Clases - Nivel 4 (Código) - Módulo Medical Staff\nPatrón: Factory Method

package "Backend API - FastAPI (monolito)" <<Container>> {

  package "Módulo Medical Staff" <<Módulo>> {

    abstract class AvailabilityGeneratorFactory <<Factory Method - Creator>> {
        + {abstract} create_generator() : AvailabilityGenerator
        + get_generator() : AvailabilityGenerator
    }

    class StandardGeneratorFactory <<Concrete Creator>> {
        + create_generator() : AvailabilityGenerator
    }

    abstract class AvailabilityGenerator <<Product>> {
        + {abstract} generate(hours, occupied : set<time>, not_before : time) : list<AvailabilitySlot>
    }

    class StandardAvailabilityGenerator <<Concrete Product>> {
        + generate(hours, occupied : set<time>, not_before : time) : list<AvailabilitySlot>
    }

    class AvailabilitySlot {
        - time : time
        - available : bool
    }

    class AvailabilityService {
        + for_date(doctor_id, date) : DayAvailability
        + calendar(doctor_id) : list<CalendarDay>
        + next_available_date(doctor_id) : date | None
        + last_bookable_date() : date
    }

    interface ScheduleLookup <<Protocol>> {
        + appointment_window_weeks() : int
        + working_hours(doctor_id) : list<WorkingDay>
    }

    interface OccupancyLookup <<Protocol>> {
        + occupied_times(doctor_id, date_from, date_to) : dict<date, set<time>>
    }

    AvailabilityGeneratorFactory <|-- StandardGeneratorFactory
    AvailabilityGenerator <|.. StandardAvailabilityGenerator
    StandardGeneratorFactory ..> StandardAvailabilityGenerator : crea >
    StandardAvailabilityGenerator ..> AvailabilitySlot : genera
    AvailabilityService --> AvailabilityGeneratorFactory : pide un generador
    AvailabilityService --> ScheduleLookup
    AvailabilityService --> OccupancyLookup
  }

  package "Módulo Configuration" <<Módulo>> {
    class ConfigurationDirectory {
        + appointment_window_weeks() : int
        + working_hours(doctor_id) : list<WorkingHours>
    }
  }

  package "Módulo Appointment" <<Módulo>> {
    class AppointmentDirectory {
        + occupied_times(doctor_id, date_from, date_to) : dict<date, set<time>>
    }
  }

  package "shared (transversal)" <<Módulo>> {
    class ColombianHolidays {
        + is_holiday(date) : bool
    }
    interface Clock {
        + now() : datetime
    }
  }
}

ConfigurationDirectory ..|> ScheduleLookup
AppointmentDirectory ..|> OccupancyLookup
AvailabilityService --> ColombianHolidays : excluye festivos
AvailabilityService --> Clock : hoy y hora actual

note right of StandardGeneratorFactory
  Hoy es la única fábrica concreta.
  Otro tipo de horario solo requiere un nuevo
  par generador/fábrica, sin tocar a
  AvailabilityService ni a quien lo consume.
end note

note bottom of AvailabilityService
  Franjas del horario configurado del profesional,
  dentro de la ventana de agendamiento, sin festivos,
  sin horas ya pasadas y marcando las ocupadas.
end note

@enduml

@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam class {
    BackgroundColor White
    BorderColor #2C3E50
    ArrowColor  #2980B9
    FontName    Arial
}
skinparam package {
    BackgroundColor #F4F8FB
    BorderColor #1168BD
    FontColor #1168BD
    FontStyle bold
}
title Diagrama de Clases - Nivel 4 (Código) - Módulo Appointment\nPatrones: Template Method, Strategy/Chain of Responsibility

package "Backend API - FastAPI (monolito)" <<Container>> {

  package "Módulo Appointment" <<Módulo>> {

    class Appointment {
        - appointment_id : int | None
        - patient_id : int
        - doctor_id : int
        - doctor_name : str
        - service_type : ServiceType
        - date : date
        - start_time : time
        - end_time : time
        - reason : str
        - notes : str
        - status : AppointmentStatus
        + schedule() : None
        + reschedule() : None
        + cancel() : None
        + mark_as_attended() : None
    }

    enum AppointmentStatus {
        AGENDADA
        REAGENDADA
        ATENDIDA
        CANCELADA
    }

    enum ServiceType {
        CONSULTA_GENERAL
        FISIOTERAPIA
        QUIROPRAXIA
        TERAPIA_NEURAL
    }

    abstract class AppointmentSchedulingTemplate <<Template Method>> {
        # _repository : AppointmentRepository
        # _validators : list<AppointmentValidator>
        + execute(Appointment) : Appointment
        # {abstract} _assign_status(Appointment) : None
    }

    class ManualAppointmentScheduling {
        # _assign_status(Appointment) : None
    }

    class AutonomousAppointmentScheduling {
        # _assign_status(Appointment) : None
    }

    abstract class AppointmentValidator <<Strategy/Chain>> {
        + {abstract} validate(Appointment, list<Appointment>) : None
    }

    class ConflictValidator {
        + validate(Appointment, list<Appointment>) : None
    }

    class AppointmentRepository {
        + find_by_doctor_and_date(int, date) : list<Appointment>
        + find_by_id(int) : Appointment | None
        + find_by_patient(int) : list<Appointment>
        + save(Appointment) : Appointment
    }

    AppointmentSchedulingTemplate <|-- ManualAppointmentScheduling
    AppointmentSchedulingTemplate <|-- AutonomousAppointmentScheduling
    AppointmentSchedulingTemplate --> Appointment
    AppointmentSchedulingTemplate --> AppointmentRepository
    AppointmentSchedulingTemplate --> AppointmentValidator
    AppointmentValidator <|.. ConflictValidator
    Appointment --> AppointmentStatus
    Appointment --> ServiceType
  }

  package "core (transversal)" <<Módulo>> {
    class EventBus {
        + publish(event_name : str, payload : dict) : None
        + subscribe(event_name : str, handler : Callable) : None
    }
  }
}

AppointmentSchedulingTemplate ..> EventBus : publica appointment.scheduled

note right of ConflictValidator
  Único validador implementado hoy;
  Data/Existence/Window/Holiday: TODO.
end note

note right of AppointmentRepository
  Contrato definido; implementación
  sobre SQLAlchemy: TODO.
end note

@enduml

@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam class {
    BackgroundColor White
    BorderColor #2C3E50
    ArrowColor  #2980B9
    FontName    Arial
}
skinparam package {
    BackgroundColor #F4F8FB
    BorderColor #1168BD
    FontColor #1168BD
    FontStyle bold
}
title Diagrama de Clases - Nivel 4 (Código) - Módulo Appointment\nPatrones: Template Method, Strategy/Chain of Responsibility, Builder

package "Backend API - FastAPI (monolito)" <<Container>> {

  package "Módulo Appointment" <<Módulo>> {

    class Appointment {
        - appointment_id : int | None
        - patient_id : int
        - doctor_id : int
        - doctor_name : str
        - service_type : ServiceType
        - date : date
        - start_time : time
        - end_time : time
        - reason : str
        - notes : str
        - status : AppointmentStatus
        + is_active : bool
        + schedule() : None
        + reschedule() : None
        + cancel() : None
        + mark_as_attended(today : date) : None
    }

    enum AppointmentStatus {
        AGENDADA
        REAGENDADA
        ATENDIDA
        CANCELADA
    }

    enum ServiceType {
        CONSULTA_GENERAL
        FISIOTERAPIA
        QUIROPRAXIA
        TERAPIA_NEURAL
        + label : str
        + specialty : str
        + requires_authorization : bool
    }

    class PatientAuthorization {
        - patient_id : int
        - service_type : ServiceType
        - authorized_at : datetime
        - expires_at : datetime
        - used : bool
        + {static} grant(Appointment, ServiceType, now) : PatientAuthorization
        + is_active(now) : bool
        + mark_used() : None
    }

    class AppointmentBuilder <<Builder>> {
        + patient(id) : AppointmentBuilder
        + doctor(id, name) : AppointmentBuilder
        + service(ServiceType) : AppointmentBuilder
        + slot(date, start, end) : AppointmentBuilder
        + reason(text) : AppointmentBuilder
        + notes(text) : AppointmentBuilder
        + build() : Appointment
    }

    class AppointmentDirector <<Director>> {
        + build_patient_appointment(...) : Appointment
        + build_manual_appointment(...) : Appointment
    }

    abstract class AppointmentSchedulingTemplate <<Template Method>> {
        # _repository : AppointmentRepository
        # _validators : list<AppointmentValidator>
        + execute(Appointment) : Appointment
        # {abstract} _assign_status(Appointment) : None
    }

    class ManualAppointmentScheduling {
        # _assign_status(Appointment) : None
    }

    class AutonomousAppointmentScheduling {
        # _assign_status(Appointment) : None
    }

    class SchedulePatientAppointment {
        + execute(user_id, PatientBooking) : Appointment
    }

    abstract class AppointmentValidator <<Strategy/Chain>> {
        + {abstract} validate(Appointment, list<Appointment>) : None
    }

    class DataAppointmentValidator
    class HolidayValidator
    class ExistenceValidator
    class ServiceOfferedValidator
    class ActiveAppointmentValidator
    class AppointmentWindowValidator
    class WorkingHoursValidator
    class MedicinaGeneralValidator
    class ConflictValidator

    class AppointmentRepository {
        + find_by_doctor_and_date(int, date) : list<Appointment>
        + find_active_by_patient(int, date) : list<Appointment>
        + find_by_doctor_between(int, date, date) : list<Appointment>
        + save(Appointment) : Appointment
    }

    class AuthorizationRepository {
        + find_active(patient_id, now) : PatientAuthorization | None
        + save(PatientAuthorization) : PatientAuthorization
    }

    AppointmentSchedulingTemplate <|-- ManualAppointmentScheduling
    AppointmentSchedulingTemplate <|-- AutonomousAppointmentScheduling
    AppointmentSchedulingTemplate --> AppointmentRepository
    AppointmentSchedulingTemplate --> "1..*" AppointmentValidator
    SchedulePatientAppointment --> AppointmentDirector
    SchedulePatientAppointment --> AutonomousAppointmentScheduling
    SchedulePatientAppointment --> AuthorizationRepository
    AppointmentDirector ..> AppointmentBuilder : usa
    AppointmentBuilder ..> Appointment : crea
    AppointmentValidator <|.. DataAppointmentValidator
    AppointmentValidator <|.. HolidayValidator
    AppointmentValidator <|.. ExistenceValidator
    AppointmentValidator <|.. ServiceOfferedValidator
    AppointmentValidator <|.. ActiveAppointmentValidator
    AppointmentValidator <|.. AppointmentWindowValidator
    AppointmentValidator <|.. WorkingHoursValidator
    AppointmentValidator <|.. MedicinaGeneralValidator
    AppointmentValidator <|.. ConflictValidator
    MedicinaGeneralValidator --> AuthorizationRepository
    Appointment --> AppointmentStatus
    Appointment --> ServiceType
    PatientAuthorization --> ServiceType
  }

  package "core y shared (transversal)" <<Módulo>> {
    class EventBus {
        + publish(event_name : str, payload : dict) : None
    }
    class ColombianHolidays {
        + is_holiday(date) : bool
    }
  }
}

AppointmentSchedulingTemplate ..> EventBus : publica appointment.scheduled
HolidayValidator --> ColombianHolidays

note right of AppointmentValidator
  Cadena en este orden: datos, festivo,
  existencia del profesional y del paciente,
  especialidad, una cita activa por paciente,
  ventana de agendamiento, horario del
  profesional, autorización médica y
  conflicto de horario.
end note

note bottom of ExistenceValidator
  Existencia, especialidad, ventana y horario
  se consultan a los módulos medical_staff,
  patient y configuration a través de sus
  interfaces públicas (Protocol en domain/ports.py).
end note

@enduml

@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Diagrama de Contenedores - Sistema Piedrazul (Monolito Modular)

Person(paciente, "Paciente", "Agenda, consulta y cancela sus citas")
Person(agendador, "Agendador", "Consulta la agenda de los profesionales")
Person(medico, "Médico", "Consulta su agenda y registra la atención")
Person(admin, "Administrador", "Gestiona la configuración del sistema")

System_Boundary(piedrazul, "Sistema de Agendamiento Piedrazul") {

  Container(frontend, "Frontend Web", "Angular 22 (standalone components)", "SPA: inicio de sesión, registro de pacientes, agendamiento autónomo, mis citas, listado de citas y configuración; muestra solo las opciones del rol del usuario")

  Container(backend, "Backend API", "FastAPI (Python) - monolito modular", "Expone una única API REST (/api/v1/*). Internamente organiza los módulos appointment, configuration, medical_staff, patient e identity por capas (api/application/domain/infrastructure), comunicados entre sí por interfaces de Python y un event bus in-process (no por red)")

  ContainerDb(db, "Base de Datos", "PostgreSQL 16", "Una sola instancia, un schema por módulo")

  Container(keycloak, "Proveedor de Identidad", "Keycloak 26", "Realm piedrazul: usuarios, roles (paciente, agendador, medico, administrador) y emisión de tokens")
}

System_Ext(correo, "Servicio de Correo", "SMTP/API externo para recordatorios de citas (pendiente de integrar)")

Rel(paciente, frontend, "Usa", "HTTPS")
Rel(agendador, frontend, "Usa", "HTTPS")
Rel(medico, frontend, "Usa", "HTTPS")
Rel(admin, frontend, "Usa", "HTTPS")

Rel(frontend, backend, "Consume API REST con el token del usuario", "HTTPS/JSON")

Rel(backend, db, "Lee/Escribe (SQLAlchemy)", "SQL")
Rel(backend, keycloak, "Autentica usuarios, crea cuentas de pacientes y obtiene las llaves para validar tokens", "HTTP/OpenID Connect")
Rel(backend, correo, "Enviará recordatorios", "SMTP/API")

note right of backend
  A diferencia de los microservicios originales,
  aquí NO hay API Gateway ni contenedores
  separados por módulo: todos corren en el
  mismo proceso. La única interfaz REST
  expuesta es la del backend hacia el frontend;
  los módulos se comunican en memoria mediante
  sus interfaces públicas (p. ej. medical_staff
  consulta el horario a configuration) y
  publican eventos en el event bus, sin HTTP.
end note

@enduml
